---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import CoursePage from "../../layouts/CoursePage.astro";
import { formatCourseDate } from "../../lib/dates";
export async function getStaticPaths(){return (await getPublishedCollection("sessions")).map((session)=>({params:{slug:session.id},props:{session}}));}
const { session } = Astro.props;
const { Content } = await render(session);
---
<CoursePage title={session.data.title} description={session.data.description} eyebrow={"WEEK " + session.data.week + " / WORKSHOP"}>
  <div class="detail-meta"><span>{formatCourseDate(session.data.date)}</span><span>14:00–15:30 / CANBERRA</span><span class="tag">FICTIONAL PRACTICE DATA</span></div>
  <article class="prose"><Content /><section class="outcomes"><h2>Before you leave</h2><ul>{session.data.spec.map((item: string)=><li>{item}</li>)}</ul></section></article>
</CoursePage>
