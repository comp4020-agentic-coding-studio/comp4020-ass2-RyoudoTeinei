---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import CoursePage from "../../layouts/CoursePage.astro";
import { formatCourseDate } from "../../lib/dates";
const sessions=(await getPublishedCollection("sessions")).sort((a,b)=>a.data.week-b.data.week);
---
<CoursePage title="Put it into practice." description="A workshop for every week. Work from the supplied records, compare your reasoning, and leave with something useful." eyebrow="THE WORKSHOPS">
  <p class="reading-intro">Wednesdays, 14:00–15:30 Canberra time. The structured exercise takes about an hour; the remaining time is for discussion and individual support.</p>
  <div class="week-list">{sessions.map((session)=><a class="week-row" href={withBase("/sessions/"+session.id+"/")}><span class="week-number">{String(session.data.week).padStart(2,"0")}</span><div><h2>{session.data.title}</h2><p>{session.data.description}</p></div><span class="week-date">{formatCourseDate(session.data.date)}</span><span aria-hidden="true">↗</span></a>)}</div>
</CoursePage>
