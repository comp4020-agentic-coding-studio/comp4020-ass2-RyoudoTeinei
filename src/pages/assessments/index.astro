---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import CoursePage from "../../layouts/CoursePage.astro";
import { formatCourseDate } from "../../lib/dates";
const assessments=(await getPublishedCollection("assessments")).sort((a,b)=>a.data.week-b.data.week);
---
<CoursePage title="Useful work. Clear expectations." description="Three assessments build on one another: identify the subscription, explain the route, then handle a case you have not seen before." eyebrow="ASSESSMENT / 100% IN TOTAL">
  <div class="assessment-list">{assessments.map((entry)=><a class="assessment-row" href={withBase("/assessments/"+entry.id+"/")}><span class="assessment-weight">{entry.data.weight}<small>%</small></span><div><span class="micro">WEEK {entry.data.week} / DUE {formatCourseDate(entry.data.due)} · 23:59 CANBERRA</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div>
  <div class="policy-callout"><h2>Your reasoning is the work.</h2><p>Use the supplied fictional records. No real subscription, coding project or personal financial data is required. A tutor reads the evidence; the practice lab does not award course marks.</p><a class="text-link" href={withBase("/policies/")}>Read submission, extension and assistance policies <span aria-hidden="true">→</span></a></div>
</CoursePage>
