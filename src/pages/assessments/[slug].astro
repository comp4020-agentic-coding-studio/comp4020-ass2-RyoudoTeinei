---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import CoursePage from "../../layouts/CoursePage.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDate } from "../../lib/dates";
export async function getStaticPaths(){return (await getPublishedCollection("assessments")).map((assessment)=>({params:{slug:assessment.id},props:{assessment}}));}
const { assessment } = Astro.props;
const { Content } = await render(assessment);
---
<CoursePage title={assessment.data.title} description={assessment.data.description} eyebrow={"ASSESSMENT / WEEK " + assessment.data.week}>
  <div class="assessment-facts"><div><span class="micro">WEIGHT</span><strong>{assessment.data.weight}%</strong></div><div><span class="micro">DUE / CANBERRA TIME</span><strong class="date-value">{formatCourseDate(assessment.data.due)}<small>23:59</small></strong></div></div>
  <article class="prose"><Content />{assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}<h2>Submission checklist</h2><ul>{assessment.data.spec.map((item:string)=><li>{item}</li>)}</ul></article>
</CoursePage>
