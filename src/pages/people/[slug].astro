---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import CoursePage from "../../layouts/CoursePage.astro";
export async function getStaticPaths(){return (await getPublishedCollection("people")).map((person)=>({params:{slug:person.id},props:{person}}));}
const { person }=Astro.props;
const { Content }=await render(person);
---
<CoursePage title={person.data.title} description={person.data.description} eyebrow="TEACHING & SUPPORT"><article class="prose"><p class="scope-note">{person.data.contact}</p><Content /></article></CoursePage>
