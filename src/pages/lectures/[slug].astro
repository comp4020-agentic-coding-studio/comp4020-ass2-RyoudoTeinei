---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import CoursePage from "../../layouts/CoursePage.astro";
import SourceNotes from "../../components/SourceNotes.astro";
import { formatCourseDate } from "../../lib/dates";
export async function getStaticPaths() {
  return (await getPublishedCollection("lectures")).map((lecture) => ({params:{slug:lecture.id},props:{lecture}}));
}
const { lecture } = Astro.props;
const { Content } = await render(lecture);
const all = (await getPublishedCollection("lectures")).sort((a,b) => a.data.week-b.data.week);
const next = all.find((entry) => entry.data.week === lecture.data.week+1);
const outcomes = Array.isArray(lecture.data.outcomes) ? lecture.data.outcomes as string[] : [];
const sessionId = "week-" + String(lecture.data.week).padStart(2,"0");
---
<CoursePage title={lecture.data.title} description={lecture.data.description} eyebrow={"WEEK " + String(lecture.data.week).padStart(2,"0") + " / " + String(lecture.data.phase)}>
  <div class="detail-meta"><span>{formatCourseDate(lecture.data.date)}</span><span>45 MIN LECTURE + INDEPENDENT READING</span>{lecture.data.caseStudy && <span class="tag">REAL-PLATFORM CASE</span>}</div>
  <div class="lesson-columns"><article class="prose">
    <section class="outcomes"><h2>After this lesson</h2><ul>{outcomes.map((item) => <li>{item}</li>)}</ul></section>
    {lecture.data.slides && <a class="deck-link" href={withBase(lecture.data.slides)}>Open the lecture slides <span aria-hidden="true">↗</span></a>}
    {lecture.data.scope && <p class="scope-note"><strong>Case scope.</strong> {String(lecture.data.scope)}</p>}
    <Content />
    <div class="lesson-next"><a class="button button-dark" href={withBase("/sessions/" + sessionId + "/")}>Do the workshop <span aria-hidden="true">→</span></a>{next && <a class="text-link" href={withBase("/lectures/" + next.id + "/")}>Next: {next.data.title}</a>}</div>
  </article><SourceNotes ids={lecture.data.sourceIds} /></div>
</CoursePage>
